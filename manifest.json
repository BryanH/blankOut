{
  "manifest_version": 3,
  "name": "Blank Out",
  "description": "Prevent links from opening in a new window or tab",
  "version": "0.0.1",
  "icons": {
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "eed2babd-2d29-4112-882e-0c7b41f5b61d",
      "data_collection_permissions": {
        "required": [ "none" ]
      }
    }
  }
}
